{
  "name": "freemap-mapnik",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node --expose-gc --max-old-space-size=4096 --unhandled-rejections=strict dist",
    "watch": "concurrently \"tsc --watch --preserveWatchOutput\" \"nodemon --delay 250ms --watch dist --watch images -e js,svg dist\""
  },
  "author": "Martin Ždila <martin.zdila@freemap.sk>",
  "license": "ISC",
  "dependencies": {
    "color-convert": "3.1.0",
    "config": "4.1.1",
    "freemap-mapserver": "file:../freemap-mapserver",
    "jsxnik": "file:../jsxnik"
  },
  "devDependencies": {
    "@types/color-convert": "2.0.4",
    "@types/config": "3.3.5",
    "@types/node": "24.3.0",
    "concurrently": "9.2.1",
    "eslint": "9.34.0",
    "nodemon": "3.1.10",
    "typescript": "5.9.2"
  }
}
