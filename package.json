{
  "name": "freemap-mapnik",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node --expose-gc --max-old-space-size=4096 --unhandled-rejections=strict dist",
    "watch": "UV_THREADPOOL_SIZE=$(nproc); tsc-watch --onSuccess \"bash -c 'node dist; echo Exited $?'\"",
    "perftest": "tsc perftest.ts && node perftest.js"
  },
  "author": "Martin Ždila <martin.zdila@freemap.sk>",
  "license": "ISC",
  "dependencies": {
    "color-convert": "3.1.0",
    "config": "4.1.1",
    "freemap-mapserver": "file:../freemap-mapserver",
    "jsxnik": "file:../jsxnik"
  },
  "devDependencies": {
    "@types/color-convert": "2.0.4",
    "@types/config": "3.3.5",
    "@types/node": "24.3.1",
    "eslint": "9.35.0",
    "tsc-watch": "^7.1.1",
    "typescript": "5.9.2"
  }
}
